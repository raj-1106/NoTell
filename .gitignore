# Foundry build outputs
contracts/out/
contracts/cache/
# contracts/broadcast/ is intentionally tracked so judges can verify deployment tx hashes on-chain.

# contracts/lib/ is intentionally tracked (vendored) — EXCEPT iden3/contracts below.
# Tradeoff: larger repo, but self-contained on clone — no install step needed.
# This matters for a hackathon where a judge or emergency rollback
# must work from a clean clone without manual setup.
# forge install with no args does nothing without .gitmodules;
# forge install <pkg> --no-git is what populated lib/ originally.

# iden3/contracts (Poseidon Solidity) — Phase 3 dependency, NOT vendored.
# We reference the deployed PoseidonT4 address rather than importing it;
# vendoring 4k+ iden3 files into a Phase 1 tag is noise, not signal.
contracts/lib/contracts/

# Circom / snarkjs build outputs (Phase 3)
circuits/build/*.r1cs
circuits/build/*.sym
circuits/build/*.wasm
circuits/build/*.zkey
circuits/build/Verifier.sol
circuits/build/verification_key.json

# Trusted setup files (large, fetched on demand)
circuits/*.ptau

# Node modules (global ignore for all packages/workspaces)
node_modules/

# Node / frontend specific
frontend/dist/
frontend/.env

# Envio indexer specific
indexer/.envio/

# Environment files — never commit secrets
.env
.env.*
!.env.example

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# CRE
cre/node_modules/
cre/.env

# Windows Alternate Data Streams
*Zone.Identifier

# Scratch scripts
*.sh
!start.sh
*.cjs
check_state.js
fetch_claim_event.js

# Secret configs
secrets.yaml

# Build folders
.cre/
# contracts/deployments/ is intentionally tracked so judges can see deployed addresses.

# Vendored Chainlink lib — large, not authored by this project
contracts/lib/chainlink-brownie-contracts/

# CRE build artefacts
cre/notell-cre/my-workflow/.cre_build_tmp.js

# AI tooling (Envio Claude skill files)
indexer/.claude/

# Vite/React boilerplate assets (not used by this project)
frontend/src/assets/react.svg
frontend/src/assets/vite.svg

# Envio boilerplate ABI example
indexer/abis/greeter-abi.json

DROPPED_KURU.md
# *.js — allow keeper scripts, ignore only generated/temp files
cre/notell-cre/my-workflow/*.js
check_balance.js
check_block.js
check_tx.js
run_checks_fetch.js
run_checks_native.js
get_policy_4.js
fetch_p4_indexer.js
test_alchemy.js
